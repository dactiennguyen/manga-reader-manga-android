*.swp

# Gói addon để đăng lên kho addon (npm run addons)
/dist/

# Screenshots taken while testing stay local, and docs hold no images
/test-screenshots/
/docs/**/*.png
/docs/**/*.jpg
/docs/**/*.jpeg
/docs/**/*.webp
# Store listing assets for Google Play are kept
!/docs/google-play/**
